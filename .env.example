APP_NAME=assessment_service

NODE_ENV=development

PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=assessment

REDIS_HOST=localhost
REDIS_PORT=6379

GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000

AI_PROVIDER=gemini
DEEPSEEK_API_KEY=sk-...

JWT_SECRET=replace_with_32_character_random_string_here
ACCESS_TOKEN_TTL=3600

# Rate Limiting (Throttler)
THROTTLE_AUTH_LIMIT=100
THROTTLE_AUTH_BURST_LIMIT=20
THROTTLE_READ_LIMIT=5000
THROTTLE_READ_BURST_LIMIT=500
THROTTLE_WRITE_LIMIT=2000
THROTTLE_WRITE_BURST_LIMIT=20
THROTTLE_ADMIN_LIMIT=100
THROTTLE_ADMIN_BURST_LIMIT=10
THROTTLE_WS_LIMIT=30
THROTTLE_WS_BURST_LIMIT=5

ADMIN_API_KEY=replace_with_32_character_random_string_here
